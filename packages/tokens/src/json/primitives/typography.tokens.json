      "letter-spacing": { "$value": "-0.03em", "$type": "dimension" }
    }
  },
  "font": {
    "$type": "fontFamily",
    "mono": {
      "$value": [
        "ui-monospace",
        "SFMono-Regular",
        "SF Mono",
        "Menlo",
        "Consolas",
        "Liberation Mono",
        "monospace"
      ]
    },
    "serif": {
      "$value": [
        "ui-serif",
        "Georgia",
        "Cambria",
        "Times New Roman",
        "Times",
        "serif"
      ]
    },
    "sans": {
      "$value": [
        "ui-sans-serif",
        "system-ui",
        "sans-serif",
        "Apple Color Emoji",
        "Segoe UI Emoji",
        "Segoe UI Symbol",
        "Noto Color Emoji"
      ]
    }
  }
