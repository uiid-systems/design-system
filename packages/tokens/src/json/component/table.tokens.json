{
  "$description": "UIID Design System - Table Component Tokens",
  "table": {
    "head": {
      "bg": { "$value": "{shade.foreground}", "$type": "color" },
      "fg": { "$value": "{shade.background}", "$type": "color" }
    },
    "size": {
      "$description": "Row rhythm per size tier. Row height and font size follow the form-control tiers so a control of the same tier sits in a cell without growing the row.",
      "xs": {
        "font-size": {
          "$value": "{forms.size.xs.font-size}",
          "$type": "dimension"
        },
        "cell-height": {
          "$value": "{forms.size.xs.height}",
          "$type": "dimension"
        },
        "cell-padding-x": {
          "$value": "{forms.size.xs.padding-x}",
          "$type": "dimension"
        },
        "cell-padding-y": { "$value": "0.25rem", "$type": "dimension" }
      },
      "sm": {
        "font-size": {
          "$value": "{forms.size.sm.font-size}",
          "$type": "dimension"
        },
        "cell-height": {
          "$value": "{forms.size.sm.height}",
          "$type": "dimension"
        },
        "cell-padding-x": {
          "$value": "{forms.size.sm.padding-x}",
          "$type": "dimension"
        },
        "cell-padding-y": { "$value": "0.25rem", "$type": "dimension" }
      },
      "md": {
        "font-size": {
          "$value": "{forms.size.md.font-size}",
          "$type": "dimension"
        },
        "cell-height": {
          "$value": "{forms.size.md.height}",
          "$type": "dimension"
        },
        "cell-padding-x": {
          "$value": "{forms.size.md.padding-x}",
          "$type": "dimension"
        },
        "cell-padding-y": { "$value": "0.5rem", "$type": "dimension" }
      },
      "lg": {
        "font-size": {
          "$value": "{forms.size.lg.font-size}",
          "$type": "dimension"
        },
        "cell-height": {
          "$value": "{forms.size.lg.height}",
          "$type": "dimension"
        },
        "cell-padding-x": {
          "$value": "{forms.size.lg.padding-x}",
          "$type": "dimension"
        },
        "cell-padding-y": { "$value": "0.75rem", "$type": "dimension" }
      }
    },
    "scroll-shadow": {
      "size": { "$value": "1.5rem", "$type": "dimension" }
    }
  }
}
