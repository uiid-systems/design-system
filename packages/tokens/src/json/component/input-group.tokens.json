{
  "$description": "UIID Design System - Input Group Component Tokens",
  "input-group": {
    "$type": "dimension",
    "action": {
      "width": { "$value": "1.5rem" },
      "height": {
        "xs": { "$value": "1.5rem" },
        "sm": { "$value": "1.75rem" },
        "md": { "$value": "2.25rem" },
        "lg": { "$value": "2.5rem" }
      },
      "border-radius": { "$value": "{spacing.unit}" }
    },
    "input": {
      "padding-inline-end": { "$value": "4rem" }
    }
  }
}
