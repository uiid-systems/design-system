{
  "$description": "UIID Design System - Semantic Shade Tokens",
  "shade": {
    "$type": "color",
    "$description": "The neutral aliases. background and foreground alias the theme's white/black; the four between them are pinned to the values the retired --shade-1..12 ramp resolved to, so nothing re-renders. They are standalone rather than ramp references on purpose: there is no achromatic ramp left to point them at, and retuning neutrals belongs in its own change.",
    "background": {
      "$value": "#fefefa",
      "$extensions": {
        "org.uiid.derive": {
          "method": "light-dark",
          "light": "{theme.white}",
          "dark": "{theme.black}"
        }
      }
    },
    "surface": {
      "$value": "#eaeae7",
      "$extensions": {
        "org.uiid.derive": {
          "method": "light-dark",
          "light": "#eaeae7",
          "dark": "#1a1a1a"
        }
      }
    },
    "accent": {
      "$value": "#ddddd9",
      "$extensions": {
        "org.uiid.derive": {
          "method": "light-dark",
          "light": "#ddddd9",
          "dark": "#242423"
        }
      }
    },
    "halftone": {
      "$value": "#7a7a78",
      "$extensions": {
        "org.uiid.derive": {
          "method": "light-dark",
          "light": "#7a7a78",
          "dark": "#7a7978"
        }
      }
    },
    "muted": {
      "$value": "#464645",
      "$extensions": {
        "org.uiid.derive": {
          "method": "light-dark",
          "light": "#464645",
          "dark": "#b2b1af"
        }
      }
    },
    "foreground": {
      "$value": "#0d0d0d",
      "$extensions": {
        "org.uiid.derive": {
          "method": "light-dark",
          "light": "{theme.black}",
          "dark": "{theme.white}"
        }
      }
    }
  }
}
