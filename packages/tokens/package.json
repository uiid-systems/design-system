{
  "name": "@uiid/tokens",
  "version": "0.0.36",
  "description": "Design tokens and CSS custom properties for the UIID design system",
  "license": "MIT",
  "author": "Adam Fratino",
  "repository": {
    "type": "git",
    "url": "https://github.com/uiid-systems/design-system",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/uiid-systems/design-system/tree/main/packages/tokens",
  "bugs": "https://github.com/uiid-systems/design-system/issues",
  "keywords": [
    "uiid",
    "react",
    "components",
    "design-system",
    "tokens",
    "css-custom-properties",
    "design-tokens"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./globals.css": "./src/globals.css",
    "./compositions.css": "./src/compositions.css",
    "./palette.css": "./src/palette.css",
    "./palette": {
      "types": "./src/palette.ts",
      "import": "./src/palette.ts"
    },
    "./*": "./src/css/*"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "node ../../scripts/generate-tokens.js",
    "dev": "node ../../scripts/generate-tokens.js",
    "watch": "nodemon --watch src/json --ext tokens.json --exec \"node ../../scripts/generate-tokens.js\"",
    "lint": "echo 'No linting for CSS tokens'",
    "format": "prettier --write \"src/**/*.css\" \"src/**/*.json\"",
    "figma:preview": "DRY_RUN=true node ./scripts/sync-to-figma.js",
    "figma:sync": "node ./scripts/sync-to-figma.js"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "ajv-cli": "^5.0.0",
    "nodemon": "^3.1.10",
    "prettier": "3.8.1",
    "react": "^19.1.1",
    "style-dictionary": "^5.4.4",
    "typescript": "~5.9.3",
    "zod": "^3.24.0"
  }
}
