{
  "name": "@uiid/tokens",
  "version": "0.6.6",
  "description": "Design tokens and CSS custom properties for the UIID design system",
  "license": "MIT",
  "author": "Adam Fratino",
  "repository": {
    "type": "git",
    "url": "https://github.com/uiid-systems/design-system",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/uiid-systems/design-system/tree/main/packages/tokens",
  "bugs": "https://github.com/uiid-systems/design-system/issues",
  "keywords": [
    "uiid",
    "react",
    "components",
    "design-system",
    "tokens",
    "css-custom-properties",
    "design-tokens"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./globals.css": "./src/globals.css",
    "./compositions.css": "./src/compositions.css",
    "./props.css": "./src/props.css",
    "./animations.css": "./src/animations.css",
    "./palette.css": "./src/palette.css",
    "./json/*": "./src/json/*",
    "./*": "./src/css/*"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "tokens": "node build-tokens.js",
    "build": "node build-tokens.js && vite build",
    "dev": "node build-tokens.js && vite build",
    "watch": "nodemon --watch src/json --ext tokens.json --exec \"node build-tokens.js\""
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "nodemon": "^3.1.14",
    "react": "^19.1.1",
    "style-dictionary": "^5.5.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^4.3.0",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
