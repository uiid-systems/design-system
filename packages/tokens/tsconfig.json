{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  /* The palette imports its ramps straight from the token JSON, and `composite`
     requires every file the program touches to be listed explicitly. */
  "include": ["src/**/*.ts", "src/**/*.json"],
  "exclude": ["node_modules", "dist"]
}
