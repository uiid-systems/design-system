{
  "name": "@uiid/design-system",
  "version": "0.9.0",
  "description": "UIID Design System — all components in a single package",
  "license": "MIT",
  "author": "Adam Fratino",
  "repository": {
    "type": "git",
    "url": "https://github.com/uiid-systems/design-system",
    "directory": "packages/design-system"
  },
  "homepage": "https://github.com/uiid-systems/design-system/tree/main/packages/design-system",
  "bugs": "https://github.com/uiid-systems/design-system/issues",
  "keywords": [
    "uiid",
    "react",
    "components",
    "design-system"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@uiid/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./globals.css": "./dist/design-system.css",
    "./icons": {
      "@uiid/source": "./src/icons.ts",
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./icons/*": {
      "types": "./icons/*.d.ts",
      "import": "./icons/*.js"
    },
    "./utils": {
      "@uiid/source": "./src/utils.ts",
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    }
  },
  "files": [
    "dist",
    "icons"
  ],
  "scripts": {
    "build": "node ../config/scripts/clean-build-output.mjs && tsc -b && vite build && node scripts/emit-icon-forwarders.mjs",
    "dev": "node scripts/emit-icon-forwarders.mjs && vite build --watch"
  },
  "dependencies": {
    "@uiid/buttons": "workspace:*",
    "@uiid/cards": "workspace:*",
    "@uiid/code": "workspace:*",
    "@uiid/forms": "workspace:*",
    "@uiid/icons": "workspace:*",
    "@uiid/indicators": "workspace:*",
    "@uiid/interactive": "workspace:*",
    "@uiid/layout": "workspace:*",
    "@uiid/lists": "workspace:*",
    "@uiid/markdown": "workspace:*",
    "@uiid/navigation": "workspace:*",
    "@uiid/overlays": "workspace:*",
    "@uiid/tables": "workspace:*",
    "@uiid/tokens": "workspace:*",
    "@uiid/typography": "workspace:*",
    "@uiid/utils": "workspace:*"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.9.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@uiid/config": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "~7.0.2"
  }
}
