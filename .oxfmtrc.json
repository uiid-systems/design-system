{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "semi": true,
  "tabWidth": 2,
  "htmlWhitespaceSensitivity": "css",
  "sortPackageJson": false,
  "sortImports": true,
  "ignorePatterns": [
    ".claude/worktrees/**",
    "packages/*/icons/**",
    "**/*.generated.ts",
    "**/CHANGELOG.md"
  ],
  "overrides": [
    {
      "files": ["**/*.css"],
      "options": {
        "printWidth": 150
      }
    }
  ]
}
