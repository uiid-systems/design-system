{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "files": [],
  "references": [
    { "path": "./packages/ai" },
    { "path": "./packages/buttons" },
    { "path": "./packages/cards" },
    { "path": "./packages/code" },
    { "path": "./packages/design-system" },
    { "path": "./packages/forms" },
    { "path": "./packages/icons" },
    { "path": "./packages/indicators" },
    { "path": "./packages/interactive" },
    { "path": "./packages/layout" },
    { "path": "./packages/lists" },
    { "path": "./packages/markdown" },
    { "path": "./packages/navigation" },
    { "path": "./packages/overlays" },
    { "path": "./packages/tables" },
    { "path": "./packages/tokens" },
    { "path": "./packages/typography" },
    { "path": "./packages/utils" },
    // Gives test, example and story files an editor project. Package tsconfigs
    // leave them out, and tsserver only finds tsconfig.check.json through here.
    // A root `tsc -b` would also typecheck tsconfig.check.json; nothing runs one.
    { "path": "./packages/config/tsconfig.check.json" },
    { "path": "./packages/config/tsconfig.check.browser.json" }
  ]
}
