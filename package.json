{
  "name": "@uiid/design-system",
  "private": true,
  "version": "0.9.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "test": "vitest --config packages/config/vitest.config.ts",
    "test:run": "vitest run --config packages/config/vitest.config.ts",
    "test:browser": "vitest run --config packages/config/vitest.browser.config.ts",
    "test:verbose": "vitest run --config packages/config/vitest.config.ts --reporter=verbose",
    "storybook": "pnpm --filter @uiid/storybook dev",
    "build-storybook": "turbo build-storybook",
    "size": "size-limit",
    "typecheck": "node packages/icons/scripts/emit-per-icon-modules.mjs --no-clean && pnpm --filter docs exec next typegen && tsc -p packages/config/tsconfig.check.json && tsc -p packages/config/tsconfig.check.browser.json && tsc -p apps/docs/tsconfig.check.json",
    "postinstall": "node packages/config/scripts/postinstall.mjs",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check",
    "generate:props": "pnpm --filter @uiid/utils generate:props",
    "npm:bootstrap": "node packages/config/scripts/check-npm-publishing.mjs --fix"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitest/browser-playwright": "^5.1.1",
    "happy-dom": "^21.0.4",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.85.0",
    "playwright": "^1.63.0",
    "size-limit": "^14.3.0",
    "turbo": "^2.11.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad",
  "pnpm": {
    "overrides": {
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "@types/react": "19.2.8",
      "@types/react-dom": "19.2.3",
      "@babel/core@<7.29.6": "^7.29.6",
      "@isaacs/brace-expansion@<5.0.1": "^5.0.1",
      "ajv@>=7 <8.18.0": "^8.18.0",
      "brace-expansion@<1.1.18": "^1.1.18",
      "brace-expansion@>=2 <2.1.4": "^2.1.4",
      "brace-expansion@>=3 <5.0.12": "^5.0.12",
      "browserslist@<4.28.7": "^4.28.7",
      "compression@<1.8.2": "^1.8.2",
      "lodash@<4.18.0": "^4.18.0",
      "minimatch@>=9 <9.0.7": "^9.0.7",
      "minimatch@>=10 <10.2.3": "^10.2.3",
      "qs@<6.16.0": "^6.16.0",
      "source-map-js@<1.2.2": "^1.2.2",
      "tinypool@<2.1.2": "^2.1.2"
    }
  }
}
