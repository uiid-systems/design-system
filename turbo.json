{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.json",
    "tsconfig.package.json",
    "vite.config.ts",
    "vitest.matchers.d.ts",
    "scripts/clean-build-output.mjs",
    "scripts/css-layers.cjs",
    "scripts/dts-relative-extensions.mjs",
    "scripts/postcss-layer-wrapper.cjs",
    "scripts/rollup-sanitize-file-name.mjs",
    "scripts/vite-plugin-preserve-directives.mjs"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@uiid/icons#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "icons/**"]
    },
    "docs#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@uiid/tokens#tokens"]
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/AGENTS.md",
        "$TURBO_ROOT$/.agents/**"
      ],
      "outputs": ["storybook-static/**"]
    }
  }
}
