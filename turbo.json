{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "docs#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@uiid/tokens#tokens"]
    },
    "storybook": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@uiid/tokens#tokens"]
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/AGENTS.md",
        "$TURBO_ROOT$/.agents/**"
      ],
      "outputs": ["storybook-static/**"]
    }
  }
}
