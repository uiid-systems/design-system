{
  // Build-free typecheck. `@uiid/source` makes @uiid/utils and @uiid/layout
  // resolve to their src/ instead of dist/, so this passes with no build.
  // Only layout is covered for now (UI-420); the rest follow.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "customConditions": ["@uiid/source"],
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["packages/layout/src", "vitest.matchers.d.ts"]
}
