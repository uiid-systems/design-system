{
  // Build-free typecheck. `@uiid/source` makes every @uiid/* package resolve
  // to its src/ instead of dist/, so this passes with no build.
  // Only layout's source is included for now; the rest follow.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "customConditions": ["@uiid/source"],
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["packages/layout/src", "vitest.matchers.d.ts"]
}
